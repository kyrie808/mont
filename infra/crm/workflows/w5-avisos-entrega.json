        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Um aviso por item').item.json.alerta_destino, text: $('Um aviso por item').item.json.alerta_texto, delay: 0, linkPreview: false }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "GAzXyugDzud6i2fY",
          "name": "Evolution API (apikey)"
        }
