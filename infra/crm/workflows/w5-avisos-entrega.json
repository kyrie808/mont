        "jsonBody": "={{ JSON.stringify({ number: $('Um aviso por item').item.json.falha_destino, text: $('Um aviso por item').item.json.falha_texto, delay: 0, linkPreview: false }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "GAzXyugDzud6i2fY",
          "name": "Evolution API (apikey)"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "O aviso nao saiu: a venda NAO e marcada, entao a proxima passada (5 min) tenta de novo — e a Equipe fica sabendo agora."
    },
    {
      "id": "as-21h",
