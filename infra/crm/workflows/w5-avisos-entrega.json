{
  "name": "W5 — Avisos de entrega (#ENTREGAS)",
  "nodes": [
    {
      "id": "a-cada-5",
      "name": "A cada 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "notes": "Faz as tres regras de horario de uma vez (a regra mora na Edge Function avisos-entrega, com testes): 19h = lote das entregas de amanha; venda lancada depois disso sai na proxima passada (\"na hora\"); 7h30 = rede de seguranca para entrega de hoje sem aviso, que tambem alerta a Equipe."
    },
    {
      "id": "devidos",
      "name": "Avisos devidos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://herlvujykltxnwqmwmyx.supabase.co/functions/v1/avisos-entrega",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ acao: 'devidos' }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "M5zuDDF22eH3VJHu",
          "name": "Ingestor Mont (x-ingestor-secret)"
        }
      }
    },
    {
      "id": "um-por-aviso",
      "name": "Um aviso por item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Nada devido = execucao termina aqui (e nao fica salva: saveDataSuccessExecution=none).\nreturn ($json.devidos ?? []).map((d) => ({ json: d }));"
      }
    },
    {
      "id": "enviar-entregas",
      "name": "Enviar no #ENTREGAS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://evolution:8080/message/sendText/mont",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.destino, text: $json.texto, delay: 0, linkPreview: false }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "GAzXyugDzud6i2fY",
          "name": "Evolution API (apikey)"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "destino vem da Edge Function (constante validada no codigo: 120363426226842631@g.us). onError continua para cair no Saiu? e avisar a Equipe — nada calado."
    },
    {
      "id": "saiu",
      "name": "Saiu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "saiu",
              "leftValue": "={{ !!$json.key?.id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "marcar",
      "name": "Marcar enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://herlvujykltxnwqmwmyx.supabase.co/functions/v1/avisos-entrega",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ acao: 'marcar_enviado', venda_id: $('Um aviso por item').item.json.venda_id, message_id: $json.key.id }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "M5zuDDF22eH3VJHu",
          "name": "Ingestor Mont (x-ingestor-secret)"
        }
      },
      "notes": "Grava aviso_grupo_enviado_em: a venda nunca mais e reenviada."
    },
    {
      "id": "alertar",
      "name": "Alertar a Equipe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "alertar",
              "leftValue": "={{ $('Um aviso por item').item.json.alertar === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "alerta-equipe",
      "name": "Alerta 7h30 na Equipe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1540,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://evolution:8080/message/sendText/mont",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
