# Modelo do infra/crm/.env — COPIAR para .env e preencher com segredos reais.
# O .env é gitignored (Regra de Ouro #7). Nunca commitar valores reais.
#
# Gerar segredos fortes:
#   pwsh:  [Convert]::ToHexString((1..32|%{Get-Random -Max 256}))
#   bash:  openssl rand -hex 32

# Postgres compartilhado (bancos `evolution` e `n8n`)
POSTGRES_USER=mont
POSTGRES_PASSWORD=

# Chave de API da Evolution — vai no header `apikey` de toda chamada
EVOLUTION_API_KEY=

# Criptografa as credenciais salvas no n8n.
# ⚠️ NÃO TROCAR depois de criada: muda a chave, morrem todas as credenciais.
N8N_ENCRYPTION_KEY=

# API do n8n (usada pelo MCP n8n-mcp pra criar/atualizar workflows)
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# Segredo compartilhado com a Edge Function whatsapp-ingestor
INGESTOR_SECRET=
